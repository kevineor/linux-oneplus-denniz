/dts-v1/;

#include "mt6893.dtsi"
#include "mt6359.dtsi"
#include "mt6893-pinfunc.h"

/ {
	model = "OnePlus Nord 2 5G";
	chassis-type = "handset";
	compatible = "oneplus,denniz", "mediatek,mt6893";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:921600n8";

		/*
		 * No earlycon: the UART clock is not set up that early.
		 * ramoops must be uncached (mem_type=1), write-combined records
		 * do not survive a reset.
		 */
		bootargs = "console=tty0 clk_ignore_unused regulator_ignore_unused pd_ignore_unused ignore_loglevel panic=1 ramoops.mem_address=0x48090000 ramoops.mem_size=0xe0000 ramoops.console_size=0x40000 ramoops.pmsg_size=0x10000 ramoops.mem_type=1 printk.devkmsg=on g_ether.dev_addr=32:70:05:18:ff:01 g_ether.host_addr=32:70:05:18:ff:02";
	};

	/*
	 * Filled in by the bootloader, which looks the memory node up by this
	 * exact path and injects its own reserved regions.
	 */
	memory {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x3e605000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		consys_emi: consys-reserve-memory {
			no-map;
			size = <0 0x450000>;
			alignment = <0 0x100000>;
			alloc-ranges = <0 0x50000000 0 0x40000000>;
		};
	};

	vusb33: regulator-vusb33 {
		compatible = "regulator-fixed";
		regulator-name = "vusb33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	vbus: regulator-vbus {
		compatible = "regulator-fixed";
		regulator-name = "vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};
};

&uart0 {
	status = "okay";
};

&usb_phy {
	status = "okay";
};

&ssusb {
	status = "okay";

	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	mediatek,u3p-dis-msk = <1>;

	vusb33-supply = <&vusb33>;
	vbus-supply = <&vbus>;

	/* VBUS does not reach the PHY on this board. */
	mediatek,force-vbus;
};

&u2port0 {
	mediatek,force-vbus;
};

&ufsphy {
	status = "okay";
};

&ufs {
	status = "okay";
};

&pwrap {
	pmic {
		interrupts-extended = <&pio 222 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&i2c5 {
	status = "okay";
	clock-frequency = <400000>;

	mt6360: pmic@34 {
		compatible = "mediatek,mt6360";
		reg = <0x34>;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupts-extended = <&pio 24 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "IRQB";

		charger {
			compatible = "mediatek,mt6360-chg";
			richtek,vinovp-microvolt = <14500000>;
			mediatek,charge-monitor = <&fuel_gauge>;
		};
	};
};

&i2c7 {
	status = "okay";
	clock-frequency = <100000>;

	fuel_gauge: fuel-gauge@55 {
		compatible = "ti,bq27541";
		reg = <0x55>;
	};
};

&mfg0 {
	domain-supply = <&mt6359_vgpu11_buck_reg>;
};

&pio {
	/* Interface to the MT6635 A-die, from consys_set_if_pinmux_mt6893(). */
	conn_pins: conn-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO174__FUNC_CONN_HRST_B>,
				 <PINMUX_GPIO175__FUNC_CONN_WB_PTA>,
				 <PINMUX_GPIO178__FUNC_CONN_WF_CTRL0>,
				 <PINMUX_GPIO179__FUNC_CONN_WF_CTRL1>,
				 <PINMUX_GPIO180__FUNC_CONN_WF_CTRL2>,
				 <PINMUX_GPIO181__FUNC_CONN_WF_CTRL3>,
				 <PINMUX_GPIO182__FUNC_CONN_WF_CTRL4>;
			drive-strength = <2>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO172__FUNC_CONN_TOP_CLK>,
				 <PINMUX_GPIO176__FUNC_CONN_BT_CLK>;
			drive-strength = <4>;
		};

		pins-data {
			pinmux = <PINMUX_GPIO173__FUNC_CONN_TOP_DATA>,
				 <PINMUX_GPIO177__FUNC_CONN_BT_DATA>;
			drive-strength = <4>;
			bias-pull-up;
		};
	};

	/* CONN_WF_CTRL2 driven high while the A-die leaves reset. */
	conn_strap_pins: conn-strap-pins {
		pins-strap {
			pinmux = <PINMUX_GPIO180__FUNC_GPIO180>;
			output-high;
		};
	};
};

&mt6359_vcn33_1_ldo_reg {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

&mt6359_vcn33_2_ldo_reg {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

&wifi {
	memory-region = <&consys_emi>;
	pinctrl-names = "default", "strap";
	pinctrl-0 = <&conn_pins>;
	pinctrl-1 = <&conn_strap_pins>;
	vcn18-supply = <&mt6359_vcn18_ldo_reg>;
	vcn13-supply = <&mt6359_vcn13_ldo_reg>;
	vcn33-1-supply = <&mt6359_vcn33_1_ldo_reg>;
	vcn33-2-supply = <&mt6359_vcn33_2_ldo_reg>;
	status = "okay";
};
